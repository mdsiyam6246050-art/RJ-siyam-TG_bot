
"use strict";

module.exports = {
    config: {
        name: "id",
        aliases: ["myid"],
        description: "Show Telegram user and chat ID",
        role: 0,
        countDown: 1
    },

    onStart: async function ({ ctx, reply }) {
        await reply(
            `👤 User ID: ${ctx.userId}\n` +
            `💬 Chat ID: ${ctx.chatId}\n` +
            `📌 Chat Type: ${ctx.chat?.type || "Unknown"}`
        );
    }
};
